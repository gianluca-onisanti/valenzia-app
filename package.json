{
  "name": "valenzia",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c magenta,cyan \"npm run dev -w @valenzia/api\" \"npm run dev -w @valenzia/web\"",
    "build": "npm run typecheck -w @valenzia/shared && npm run typecheck -w @valenzia/api && npm run build -w @valenzia/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "node scripts/test.mjs",
    "db:generate": "npm run db:generate -w @valenzia/api",
    "db:migrate": "npm run db:migrate -w @valenzia/api",
    "import:legacy": "npm run import:legacy -w @valenzia/api --"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "typescript": "^5.7.0",
    "vitest": "^5.1.2"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
